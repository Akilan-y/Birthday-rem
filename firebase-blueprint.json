{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile and local reminder preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "User display name from Google Sign-In."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "description": "Verified email address of the account owner."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "dailyHour": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Preferred daily notification time in HH:MM format."
        },
        "defaultAdvanceDays": {
          "type": "integer",
          "enum": [0, 1, 3, 7],
          "description": "Default advance notice in days."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether local birthday alerts are enabled."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "displayName", "email", "dailyHour", "defaultAdvanceDays", "notificationsEnabled", "createdAt", "updatedAt"]
    },
    "BirthdayEntry": {
      "title": "BirthdayEntry",
      "description": "A manually entered birthday reminder owned by a specific user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique identifier for the birthday entry."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the owner."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Person's name."
        },
        "month": {
          "type": "integer",
          "description": "Birth month (1-12)."
        },
        "day": {
          "type": "integer",
          "description": "Birth day (1-31)."
        },
        "birthYear": {
          "type": "integer",
          "description": "Optional birth year (1900-2100) or null."
        },
        "group": {
          "type": "string",
          "enum": ["Family", "Friends", "Remembrance"],
          "maxLength": 20,
          "description": "Relationship circle."
        },
        "note": {
          "type": "string",
          "maxLength": 280,
          "description": "Eco-friendly gift idea or personal note."
        },
        "advanceDays": {
          "type": "integer",
          "enum": [0, 1, 3, 7],
          "description": "Days before the birthday to trigger a reminder."
        },
        "celebratedYears": {
          "type": "array",
          "description": "Bounded list of years in which wishes were recorded."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["id", "ownerId", "name", "month", "day", "group", "note", "advanceDays", "celebratedYears", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Multi-turn Gemini celebration assistant chat message owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique message identifier."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the owner."
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "maxLength": 10,
          "description": "Sender role in the conversation."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Message text content."
        },
        "persona": {
          "type": "string",
          "enum": ["eco-gifting", "milestone-planner", "quick-wishes"],
          "maxLength": 32,
          "description": "Assistant role persona selected for this message."
        },
        "model": {
          "type": "string",
          "maxLength": 64,
          "description": "Gemini model identifier used."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when message was stored."
        }
      },
      "required": ["id", "ownerId", "role", "text", "persona", "model", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile and notification preferences, readable and writable only by the verified owner."
    },
    "/users/{userId}/birthdays/{birthdayId}": {
      "schema": {
        "$ref": "#/entities/BirthdayEntry"
      },
      "description": "User-owned birthday entries synced to Firestore."
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Persistent multi-turn Gemini assistant chat history per user."
    }
  }
}
