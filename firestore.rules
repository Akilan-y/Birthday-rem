rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidGroup(group) {
      return group is string && group in ['Family', 'Friends', 'Remembrance'];
    }

    function isValidAdvanceDays(days) {
      return days is int && days in [0, 1, 3, 7];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'dailyHour',
          'defaultAdvanceDays', 'notificationsEnabled', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'dailyHour',
          'defaultAdvanceDays', 'notificationsEnabled', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.dailyHour is string && data.dailyHour.size() == 5 && data.dailyHour.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        isValidAdvanceDays(data.defaultAdvanceDays) &&
        data.notificationsEnabled is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGalleryPhoto(photo) {
      return photo is map &&
        photo.keys().hasAll(['id', 'name', 'mimeType', 'createdAt']) &&
        photo.keys().hasOnly(['id', 'driveFileId', 'name', 'mimeType', 'caption', 'createdAt']) &&
        photo.id is string && photo.id.size() >= 1 && photo.id.size() <= 128 &&
        (!('driveFileId' in photo) || photo.driveFileId == null || (photo.driveFileId is string && photo.driveFileId.size() <= 128)) &&
        photo.name is string && photo.name.size() >= 1 && photo.name.size() <= 160 &&
        photo.mimeType is string && photo.mimeType.size() >= 1 && photo.mimeType.size() <= 80 &&
        (!('caption' in photo) || photo.caption == null || (photo.caption is string && photo.caption.size() <= 200)) &&
        photo.createdAt is string && photo.createdAt.size() <= 40;
    }

    function isValidBirthday(data, userId, birthdayId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'month', 'day',
          'group', 'note', 'advanceDays', 'celebratedYears', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'month', 'day', 'birthYear',
          'group', 'note', 'advanceDays', 'celebratedYears',
          'phone', 'email', 'relation', 'favoriteThings',
          'avatarFileId', 'avatarThumb', 'galleryPhotos',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == birthdayId && isValidId(data.id) &&
        data.ownerId is string && data.ownerId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.month is int && data.month >= 1 && data.month <= 12 &&
        data.day is int && data.day >= 1 && data.day <= 31 &&
        (!('birthYear' in data) || data.birthYear == null || (data.birthYear is int && data.birthYear >= 1900 && data.birthYear <= 2100)) &&
        isValidGroup(data.group) &&
        data.note is string && data.note.size() <= 280 &&
        isValidAdvanceDays(data.advanceDays) &&
        data.celebratedYears is list && data.celebratedYears.size() <= 100 &&
        (data.celebratedYears.size() == 0 || data.celebratedYears[0] is int) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 40)) &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
        (!('relation' in data) || data.relation == null || (data.relation is string && data.relation.size() <= 60)) &&
        (!('favoriteThings' in data) || data.favoriteThings == null || (data.favoriteThings is string && data.favoriteThings.size() <= 280)) &&
        (!('avatarFileId' in data) || data.avatarFileId == null || (data.avatarFileId is string && data.avatarFileId.size() <= 128)) &&
        (!('avatarThumb' in data) || data.avatarThumb == null || (data.avatarThumb is string && data.avatarThumb.size() <= 45000)) &&
        (!('galleryPhotos' in data) || (
          data.galleryPhotos is list &&
          data.galleryPhotos.size() <= 50 &&
          (data.galleryPhotos.size() == 0 || (
            isValidGalleryPhoto(data.galleryPhotos[0]) &&
            isValidGalleryPhoto(data.galleryPhotos[data.galleryPhotos.size() - 1])
          ))
        )) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId, messageId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'role', 'text', 'persona', 'model', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'role', 'text', 'persona', 'model', 'createdAt'
        ]) &&
        data.id is string && data.id == messageId && isValidId(data.id) &&
        data.ownerId is string && data.ownerId == userId &&
        data.role is string && data.role in ['user', 'model'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 8000 &&
        data.persona is string && data.persona in ['eco-gifting', 'milestone-planner', 'quick-wishes'] &&
        data.model is string && data.model.size() >= 1 && data.model.size() <= 64 &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'dailyHour',
          'defaultAdvanceDays', 'notificationsEnabled', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /birthdays/{birthdayId} {
        allow get: if isValidId(userId) && isValidId(birthdayId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(birthdayId) &&
          isOwner(userId) &&
          isValidBirthday(incoming(), userId, birthdayId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidId(userId) &&
          isValidId(birthdayId) &&
          isOwner(userId) &&
          isValidBirthday(incoming(), userId, birthdayId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'month', 'day', 'birthYear', 'group',
              'note', 'advanceDays', 'celebratedYears',
              'phone', 'email', 'relation', 'favoriteThings',
              'avatarFileId', 'avatarThumb', 'galleryPhotos',
              'updatedAt'
            ])
          );
        allow delete: if isValidId(userId) &&
          isValidId(birthdayId) &&
          isOwner(userId) &&
          existing().ownerId == request.auth.uid;
      }

      match /chatMessages/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(messageId) &&
          isOwner(userId) &&
          isValidChatMessage(incoming(), userId, messageId) &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(userId) &&
          isValidId(messageId) &&
          isOwner(userId) &&
          existing().ownerId == request.auth.uid;
      }
    }
  }
}
